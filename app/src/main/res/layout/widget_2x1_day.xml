<?xml version="1.0" encoding="utf-8"?>
<!-- 2x1 小组件 (仅日视图): 表头(年月+右上角星期) + 日期 + 农历/休班 + 今日事件 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg_card"
    android:orientation="vertical"
    android:padding="8dp">

    <!-- 表头: 年月 + 右上角星期 (与月/周视图一致) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/widget_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="2026年8月"
            android:textColor="@color/widget_text_primary"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_weekday"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="周三"
            android:textColor="@color/widget_accent_text"
            android:textSize="9sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- 内容: 左 (日期大数字 + 农历/休班) | 右 (今日事件) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="5"
            android:gravity="center_vertical"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_day"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="19"
                android:textColor="@color/widget_text_primary"
                android:textSize="38sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/widget_lunar"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="六月廿三"
                    android:textColor="@color/widget_text_dim"
                    android:textSize="9sp" />

                <TextView
                    android:id="@+id/widget_workday"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:text=""
                    android:textColor="@color/widget_accent_text"
                    android:textSize="9sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <!-- 右: 今日事件 (最多 2 条 + 共 x 个事件) -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="7"
            android:gravity="center_vertical|end"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_event1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:singleLine="true"
                android:text="09:00 团队会议"
                android:textColor="@color/widget_text_primary"
                android:textSize="10sp" />

            <TextView
                android:id="@+id/widget_event2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:singleLine="true"
                android:text="14:00 健身"
                android:textColor="@color/widget_text_primary"
                android:textSize="10sp" />

            <TextView
                android:id="@+id/widget_event_more"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="共 5 个事件"
                android:textColor="@color/widget_accent_text"
                android:textSize="10sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
