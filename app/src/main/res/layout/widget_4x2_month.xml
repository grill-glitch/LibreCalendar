<?xml version="1.0" encoding="utf-8"?>
<!-- 4x2 月视图: 月标题 + 6x7 网格 (事件圈/今天高亮) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#1A1A1A"
    android:orientation="vertical"
    android:padding="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="2026年8月"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_lunar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="农历六月廿三"
            android:textColor="#B3FFFFFF"
            android:textSize="10sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/grid"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/row0"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">
            <TextView android:id="@+id/cell00" style="@style/WidgetCell" />
            <TextView android:id="@+id/cell01" style="@style/WidgetCell" />
            <TextView android:id="@+id/cell02" style="@style/WidgetCell" />
            <TextView android:id="@+id/cell03" style="@style/WidgetCell" />
            <TextView android:id="@+id/cell04" style="@style/WidgetCell" />
            <TextView android:id="@+id/cell05" style="@style/WidgetCell" />
            <TextView android:id="@+id/cell06" style="@style/WidgetCell" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/row1"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">
            <TextView android:id="@+id/cell10" style="@style/WidgetCell" />
            <TextView android:id="@+id/cell11" style="@style/WidgetCell" />
            <TextView android:id="@+id/cell12" style="@style/WidgetCell" />
            <TextView android:id="@+id/cell13" style="@style/WidgetCell" />
            <TextView android:id="@+id/cell14" style="@style/WidgetCell" />
            <TextView android:id="@+id/cell15" style="@style/WidgetCell" />
            <TextView android:id="@+id/cell16" style="@style/WidgetCell" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/row2"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">
            <TextView android:id="@+id/cell20" style="@style/WidgetCell" />
            <TextView android:id="@+id/cell21" style="@style/WidgetCell" />
            <TextView android:id="@+id/cell22" style="@style/WidgetCell" />
            <TextView android:id="@+id/cell23" style="@style/WidgetCell" />
            <TextView android:id="@+id/cell24" style="@style/WidgetCell" />
            <TextView android:id="@+id/cell25" style="@style/WidgetCell" />
            <TextView android:id="@+id/cell26" style="@style/WidgetCell" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/row3"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">
            <TextView android:id="@+id/cell30" style="@style/WidgetCell" />
            <TextView android:id="@+id/cell31" style="@style/WidgetCell" />
            <TextView android:id="@+id/cell32" style="@style/WidgetCell" />
