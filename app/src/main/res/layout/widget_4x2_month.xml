            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">
            <TextView android:id="@+id/cell50" style="@style/WidgetCell" />
            <TextView android:id="@+id/cell51" style="@style/WidgetCell" />
            <TextView android:id="@+id/cell52" style="@style/WidgetCell" />
            <TextView android:id="@+id/cell53" style="@style/WidgetCell" />
