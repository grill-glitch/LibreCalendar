<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- 桌面小组件样式 (RemoteViews 可用基础属性) -->

    <!-- 4x2 月网格单元格 -->
    <style name="WidgetCell">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_weight">1</item>
        <item name="android:gravity">center</item>
        <item name="android:textSize">10sp</item>
        <item name="android:textColor">#E6FFFFFF</item>
        <item name="android:maxLines">1</item>
    </style>

    <!-- 4x2 周视图列 -->
    <style name="WidgetWeekCol">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_weight">1</item>
        <item name="android:orientation">vertical</item>
    </style>

    <!-- 4x2 周视图星期名 -->
    <style name="WidgetWeekName">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">0dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:gravity">center</item>
        <item name="android:textSize">9sp</item>
        <item name="android:textColor">#80FFFFFF</item>
    </style>

    <!-- 4x2 周视图日期数字 -->
    <style name="WidgetWeekDay">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">0dp</item>
        <item name="android:layout_weight">2</item>
        <item name="android:gravity">center</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">#FFFFFF</item>
    </style>
</resources>
