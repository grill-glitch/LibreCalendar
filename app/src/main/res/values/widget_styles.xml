<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- 桌面小组件样式 (RemoteViews 可用基础属性) -->

    <!-- 4x2 月网格单元格容器: 均分宽, 内容居中 (FrameLayout: 环在下, 数字在上) -->
    <style name="WidgetCell">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_weight">1</item>
        <item name="android:gravity">center</item>
    </style>

    <!-- 4x2 月网格标记环: 28dp 方形 ImageView (fill/ring drawable + setColorFilter 任意色)
         与应用内月视图比例一致: 月视图格子 ~48dp 内圆环 ~32dp (约 2/3), 此 28dp 对 ~44dp 格 -->
    <style name="WidgetRing">
        <item name="android:layout_width">28dp</item>
        <item name="android:layout_height">28dp</item>
        <item name="android:layout_gravity">center</item>
        <item name="android:src">@drawable/widget_circle_fill</item>
    </style>

    <!-- 4x2 月网格日期数字: 居中于环内 -->
    <style name="WidgetCellText">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_gravity">center</item>
        <item name="android:gravity">center</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textColor">@color/widget_text_primary</item>
        <item name="android:maxLines">1</item>
    </style>

    <!-- 4x2 月视图星期表头 -->
    <style name="WidgetWeekHead">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:gravity">center</item>
        <item name="android:textSize">9sp</item>
        <item name="android:textColor">@color/widget_text_secondary</item>
        <item name="android:paddingTop">1dp</item>
        <item name="android:paddingBottom">2dp</item>
    </style>

    <!-- 周/月视图环 (今天浅圆 / 事件色圆环): 与月视图同尺寸, 居中重叠于数字后 -->
    <style name="WidgetCellRing">
        <item name="android:layout_width">28dp</item>
        <item name="android:layout_height">28dp</item>
        <item name="android:layout_gravity">center</item>
        <item name="android:src">@android:color/transparent</item>
    </style>

    <!-- 4x2 周视图列 -->
    <style name="WidgetWeekCol">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_weight">1</item>
        <item name="android:orientation">vertical</item>
    </style>

    <!-- 4x2 周视图星期名 -->
    <style name="WidgetWeekName">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">0dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:gravity">center</item>
        <item name="android:textSize">9sp</item>
        <item name="android:textColor">@color/widget_text_secondary</item>
    </style>

    <!-- 4x2 周视图日期数字 -->
    <style name="WidgetWeekDay">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">0dp</item>
        <item name="android:layout_weight">2</item>
        <item name="android:gravity">center</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/widget_text_primary</item>
    </style>
</resources>
